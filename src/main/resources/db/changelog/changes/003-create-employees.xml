<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-employees" author="Adam Mudrak">
        <createTable tableName="employees">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_employees" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_employees_email"/>
            </column>
            <column name="pending_email" type="VARCHAR(255)">
                <constraints unique="true" uniqueConstraintName="uk_employees_pending_email"/>
            </column>
            <column name="email_confirmed" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="password" type="VARCHAR(255)"/>
            <column name="password_created_at" type="DATETIME(6)"/>
            <column name="password_updated_at" type="DATETIME(6)"/>
            <column name="profile_picture_id" type="BIGINT">
                <constraints foreignKeyName="fk_employees_profile_picture"
                             referencedTableName="images"
                             referencedColumnNames="id"
                             unique="true"
                             uniqueConstraintName="uk_employees_profile_picture"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_employees_role"
                             referencedTableName="roles"
                             referencedColumnNames="id"/>
            </column>
            <column name="is_deleted" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="employee_shifts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_employee_shifts"
                             nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_employee_shifts_employee"
                             referencedTableName="employees"
                             referencedColumnNames="id"/>
            </column>
            <column name="work_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="starts_at" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="ends_at" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(1000)"/>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="employee_shifts" indexName="idx_employee_shifts_employee_date">
            <column name="employee_id"/>
            <column name="work_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
