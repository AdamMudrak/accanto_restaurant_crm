<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="012-create-order-items" author="Adam Mudrak">
        <createTable tableName="order_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_order_items" nullable="false"/>
            </column>
            <column name="guest_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_order_items_guest"
                             referencedTableName="guests"
                             referencedColumnNames="id"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_order_items_order"
                             referencedTableName="orders"
                             referencedColumnNames="id"/>
            </column>
            <column name="menu_item_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_order_items_menu_item"
                             referencedTableName="menu_items"
                             referencedColumnNames="id"/>
            </column>
            <column name="payment_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_order_items_payment"
                             referencedTableName="payments"
                             referencedColumnNames="id"/>
            </column>
            <column name="item_name_snapshot" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="item_price_snapshot" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)" defaultValue="ORDERED">
                <constraints nullable="false"/>
            </column>
            <column name="client_note" type="VARCHAR(255)"/>
            <column name="employee_note" type="VARCHAR(255)"/>
        </createTable>

        <createIndex tableName="order_items" indexName="idx_order_items_payment_id">
            <column name="payment_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
