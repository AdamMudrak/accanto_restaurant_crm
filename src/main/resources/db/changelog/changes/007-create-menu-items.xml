<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-create-menu-items" author="Adam Mudrak">
        <createTable tableName="menu_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_menu_items" nullable="false"/>
            </column>
            <column name="name_default_language" type="VARCHAR(255)"/>
            <column name="name_second_language" type="VARCHAR(255)"/>
            <column name="description_default_language" type="VARCHAR(1000)"/>
            <column name="description_second_language" type="VARCHAR(1000)"/>
            <column name="is_allergenic" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_vegetarian" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_vegan" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_available" type="TINYINT(1)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="max_quantity_per_person" type="INT"/>
            <column name="weight_grams" type="INT"/>
            <column name="price" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="item_image_id" type="BIGINT">
                <constraints foreignKeyName="fk_menu_items_image"
                             referencedTableName="images"
                             referencedColumnNames="id"/>
            </column>
            <column name="menu_category_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_menu_items_category"
                             referencedTableName="menu_categories"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
