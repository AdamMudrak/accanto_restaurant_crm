<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-create-dining-tables" author="Adam Mudrak">
        <createTable tableName="dining_tables">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_dining_tables" nullable="false"/>
            </column>
            <column name="qr_uuid" type="VARCHAR(255)">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_dining_tables_qr"/>
            </column>
            <column name="is_active" type="TINYINT(1)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
